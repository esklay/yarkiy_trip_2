# СЕКРЕТЫ И ЛОКАЛЬНЫЕ НАСТРОЙКИ
# =============================================================================
# config.json содержит EmailJS-ключи (publicKey, serviceId, templateId).
# Публичные ключи EmailJS не являются секретными, поэтому можно коммитить —
# но если используете приватный ключ, перенесите config.json в .gitignore
# и создайте config.example.json с пустыми значениями.
# config.json

